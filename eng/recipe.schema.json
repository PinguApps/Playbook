{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "edition", "title", "goal", "areas", "exampleLanguages", "tags", "apis", "introducedIn", "supportedTargets", "stability", "applicability", "sources", "evidence", "humanProof", "snippets"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
    "edition": { "$ref": "#/definitions/release" },
    "title": { "$ref": "#/definitions/text" },
    "goal": { "$ref": "#/definitions/text" },
    "areas": { "$ref": "#/definitions/nonemptyStrings" },
    "exampleLanguages": { "$ref": "#/definitions/strings" },
    "languageNeutral": { "type": "boolean" },
    "tags": { "$ref": "#/definitions/strings" },
    "apis": { "$ref": "#/definitions/strings" },
    "introducedIn": { "$ref": "#/definitions/release" },
    "supportedTargets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/release" } },
    "stability": { "enum": ["stable", "preview", "experimental"] },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes"],
      "properties": {
        "routes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/route" } }
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "url"],
        "properties": { "title": { "$ref": "#/definitions/text" }, "url": { "$ref": "#/definitions/text" } }
      }
    },
    "humanProof": {
      "type": "object", "additionalProperties": false, "required": ["status", "scope"],
      "properties": {
        "status": { "enum": ["not-required", "pending", "verified"] },
        "scope": { "$ref": "#/definitions/text" }
      }
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "sample", "target", "sdk", "language", "scope"],
        "properties": {
          "kind": { "enum": ["official-review", "compile", "cross-compile", "mock", "execution", "compile-and-run"] },
          "record": { "$ref": "#/definitions/text" },
          "sample": { "$ref": "#/definitions/text" },
          "target": { "$ref": "#/definitions/text" },
          "sdk": { "$ref": "#/definitions/text" },
          "language": { "$ref": "#/definitions/text" },
          "scope": { "$ref": "#/definitions/text" }
        }
      }
    },
    "snippets": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["path", "region", "language"],
        "properties": {
          "path": { "$ref": "#/definitions/text" },
          "region": { "$ref": "#/definitions/text" },
          "language": { "$ref": "#/definitions/text" }
        }
      }
    }
  },
  "definitions": {
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "conditional", "usage", "selectionNotes", "requirements", "sourceUrls", "evidenceSamples"],
      "properties": {
        "target": { "$ref": "#/definitions/release" },
        "sharedAreas": { "$ref": "#/definitions/strings" },
        "neutralLanguages": { "$ref": "#/definitions/strings" },
        "conditional": { "type": "boolean" },
        "usage": { "enum": ["primary", "optional-alternative"] },
        "selectionNotes": { "$ref": "#/definitions/strings" },
        "requirements": { "$ref": "#/definitions/requirements" },
        "sourceUrls": { "$ref": "#/definitions/nonemptyStrings" },
        "evidenceSamples": { "$ref": "#/definitions/nonemptyStrings" }
      }
    },
    "versionRequirement": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "match", "reason"],
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)*(-[0-9A-Za-z.-]+)?$" },
        "match": { "enum": ["exact", "release-family"] },
        "reason": { "$ref": "#/definitions/text" }
      }
    },
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "sdk", "language", "frameworks", "packages", "workloads", "packageAssets", "providers", "platforms", "renderingModes", "prerequisites", "constraints"],
      "properties": {
        "runtime": { "$ref": "#/definitions/versionRequirement" },
        "sdk": { "$ref": "#/definitions/versionRequirement" },
        "language": { "anyOf": [
          { "$ref": "#/definitions/versionRequirement" },
          {
            "type": "object", "additionalProperties": false,
            "required": ["name", "version", "match", "reason"],
            "properties": {
              "name": { "$ref": "#/definitions/text" },
              "version": { "const": "preview" },
              "match": { "const": "exact" },
              "reason": { "$ref": "#/definitions/text" }
            }
          }
        ] },
        "frameworks": { "$ref": "#/definitions/strings" },
        "packages": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/versionRequirement" } },
        "workloads": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/versionRequirement" } },
        "packageAssets": { "$ref": "#/definitions/strings" },
        "providers": { "$ref": "#/definitions/strings" },
        "platforms": { "$ref": "#/definitions/nonemptyStrings" },
        "renderingModes": { "$ref": "#/definitions/strings" },
        "prerequisites": { "$ref": "#/definitions/nonemptyStrings" },
        "constraints": { "$ref": "#/definitions/nonemptyStrings" },
        "optIns": { "$ref": "#/definitions/strings" },
        "stabilityLimitations": { "$ref": "#/definitions/strings" }
      }
    },
    "release": { "type": "string", "pattern": "^[1-9][0-9]*\\.0$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/text" } },
    "nonemptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/text" } }
  }
}
