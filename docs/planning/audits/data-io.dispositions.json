    { "id": "memory-safety", "pattern": "^\\w+ System\\.(Buffers\\.MemoryHandle|Runtime\\.InteropServices\\.SequenceMarshal|IO\\.UnmanagedMemoryStream|ReadOnlySpan`1|Span`1)|^method System\\.(String::\\.ctor|Text\\.(Decoder|Encoder|Encoding)::)", "disposition": "grouped", "owner": "PIN-715" },
