<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>playbook</ToolCommandName>
    <PackageId>PinguApps.Playbook</PackageId>
    <RollForward>Major</RollForward>
    <Description>Original, offline .NET implementation recipes for coding agents over stdio MCP.</Description>
    <RecipeRoot Condition="'$(RecipeRoot)' == ''">$(MSBuildProjectDirectory)/../../content/recipes</RecipeRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="$(IntermediateOutputPath)Generated/catalogue.json" LogicalName="Playbook.Catalogue" />
    <EmbeddedResource Include="../../content/coverage.json" LogicalName="Playbook.Coverage" />
  </ItemGroup>
  <Target Name="GenerateRecipeContent" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../eng/Build-Content.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Generated/catalogue.json&quot; -RecipeRoot &quot;$(RecipeRoot)&quot;" />
  </Target>
</Project>
