          "providers": [],
          "platforms": [
            "Browser with WebAssembly; local development server on Windows x64 verified"
          ],
          "renderingModes": [
            "Standalone client-side WebAssembly"
          ],
          "prerequisites": [
            "Use Microsoft.NET.Sdk.BlazorWebAssembly and retain matching JS/managed/runtime assets. Default interpreted WASM builds need no optional workload, native SDK or provider; AOT and production publish are not demonstrated."
          ],
          "constraints": [
            "GetWebRendererId runs during base construction: use static allocation independent of derived instance initialization. The four-argument base constructor has no identity parameter.",
            "This is a bounded one-button browser adapter using internal attachment/dispatch contracts, not a general DOM renderer. Do not enable workers or multithreading. Coordinate a host-wide disjoint identity range."
          ],
          "optIns": [],
          "stabilityLimitations": [
