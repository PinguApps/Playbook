{
  "id": "blazor.allocate-web-renderer-identity",
  "edition": "11.0",
  "title": "Allocate custom web renderer identities",
  "goal": "Allocate distinct identities before custom WebRenderer attachment when hosting multiple independent browser control surfaces. BL0006: framework integration contracts may change.",
  "areas": [
    "blazor"
  ],
  "exampleLanguages": [
    "csharp"
  ],
  "tags": [
    "migration",
    "renderer-identity"
  ],
  "apis": [
    "WebRenderer.GetWebRendererId",
    "WebRenderer.RendererId",
    "JSComponentInterop"
  ],
  "introducedIn": "11.0",
  "supportedTargets": [
    "11.0"
  ],
  "stability": "stable",
  "applicability": {
    "routes": [
      {
        "target": "11.0",
        "conditional": false,
        "usage": "primary",
        "selectionNotes": [
          "Specialized framework WebRenderer integration only. BL0006 warns RenderTree contracts may change; suppression is local to the adapter. Not ordinary component authoring.",
          "The bounded browser adapter supports two single-button surfaces on one WASM browser thread, with no workers; IDs 201+ are reserved by this host."
        ],
        "requirements": {
