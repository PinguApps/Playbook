{
  "id": "networking.bind-linux-negotiate-to-tls",
  "edition": "11.0",
  "title": "Bind Linux Negotiate authentication to TLS",
  "goal": "Supply the actual TLS endpoint binding to .NET 11 Linux GSSAPI authentication to reject mismatched bindings; use only where the documented provider behavior fits the security policy, since tested MIT Kerberos accepts clients that omit bindings.",
  "areas": [
    "libraries"
  ],
  "exampleLanguages": [
    "csharp"
  ],
  "tags": [
    "gannet-authentication",
    "linux",
