    "NegotiateAuthentication.GetOutgoingBlob"
  ],
  "introducedIn": "11.0",
  "supportedTargets": [
    "11.0"
  ],
  "stability": "stable",
  "applicability": {
    "routes": [
      {
        "target": "11.0",
        "usage": "primary",
        "conditional": false,
        "requirements": {
          "sdk": {
            "match": "release-family",
            "reason": "Canonical net11.0 consumer; SDK11 RC3 is the exact measured compiler baseline.",
            "name": ".NET SDK",
            "version": "11.0"
          },
          "runtime": {
            "match": "release-family",
            "reason": "Linux server forwards Binding to GSSAPI in .NET11; required policy is unsupported on the tested .NET10 Linux runtime.",
            "name": ".NET",
            "version": "11.0"
          },
          "language": {
            "match": "exact",
            "name": "C#",
            "version": "15.0",
            "reason": "Canonical net11.0 project explicitly selects C#15.0; the proxy API does not itself require new language syntax. This is the configured example route, not a minimum-language claim."
          },
          "frameworks": [
            "Microsoft.NETCore.App 11 shared framework"
          ],
          "packages": [],
          "packageAssets": [
            "Framework System.Net.Security and its native GSSAPI bridge; no NuGet package or managed-NTLM server claim."
          ],
          "workloads": [],
          "prerequisites": [
            "Actual authenticated TLS connection and server certificate; this bounded sample supports SHA256-with-RSA certificates.",
            "MIT Kerberos KDC, service keytab HTTP/station.gannet.test and client credential cache; configure KRB5_CONFIG, KRB5_KTNAME and KRB5CCNAME privately.",
            "Keep ChannelBinding and SslStream alive through completion; inspect status codes and reject any non-Completed final result."
          ],
          "platforms": [
            "Ubuntu24.04 x64/MIT Kerberos1.20.1/OpenSSL3.0.13 measured; macOS excluded by runtime source; other providers/architectures not tested."
          ],
          "providers": [
            "MIT libgssapi-krb5-2/libkrb5-3 1.20.1-6ubuntu2.10; actual private disposable realm and real Kerberos mechanism."
          ],
          "renderingModes": [],
          "optIns": [],
          "stabilityLimitations": [
            "Actual .NET10.0.14/.NET11RC3 and native provider evidence; final-GA and mandatory omission-rejection gates remain open, with no promised future fix."
          ],
          "constraints": [
            "PolicyEnforcement.Always does not make the measured MIT provider reject a client that omits bindings; do not enable this route when mandatory client binding is required.",
            "BadBinding can coexist with IsAuthenticated=true on this runtime: require Completed, never trust that property alone.",
            "Do not use a different certificate, accept arbitrary TLS certificates or infer Linux/macOS/managed-NTLM support from a Unix filename."
          ]
        },
