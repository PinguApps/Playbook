          "packageAssets": [
            "Microsoft.Maui.Controls.Maps 11.0.0-rc.2.26505.5: net11.0-windows10.0.19041 library. QuayContracts compiles linked source against actual Windows assets; this does not compile the iOS application."
          ],
          "workloads": [
            {
              "name": "maui-windows",
              "version": "11.0",
              "match": "release-family",
              "reason": "Matching native SDK/workload required. Current RC3 installation fails Windows MAUI with NETSDK1147; Mac/Xcode unavailable."
            }
          ],
          "providers": [
            "Azure Maps account and authorized subscription key; network access and WebView2 runtime"
          ],
          "platforms": [
            "Windows10.0.19041 target, win-x64, minimum10.0.17763; matched WinUI/Windows App SDK"
          ],
          "renderingModes": [
            "Native MAUI map handler; Windows WinUI MapControl uses internal WebView2/Azure Maps JS. No Blazor rendering mode."
          ],
          "prerequisites": [
            "UseMauiMaps registration and matching workload; provider access separately authorized. Placeholder is deliberately invalid. No provisioning or credential acquisition is part of this recipe."
          ],
          "constraints": [
            "Source/contract compilation does not establish native rendering or provider behavior. See exact not-tested samples and PIN-935.",
            "Pinned RC2 camera navigation unsupported: control sends MoveToRegionRequest but Windows handler expects MapSpan; do not rely on MoveToRegion or Region."
          ],
          "optIns": [],
          "stabilityLimitations": [
            "RC2 package/source preparation evidence, not GA verification; no ExperimentalAttribute or experimental opt-in applies to these map APIs."
          ]
        },
