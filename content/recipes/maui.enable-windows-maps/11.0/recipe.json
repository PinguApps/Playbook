{
  "id": "maui.enable-windows-maps",
  "edition": "11.0",
  "title": "Enable the supported Windows map and pin surface",
  "goal": "Register an Azure Maps service key for the Windows MAUI map and standard pin surface; RC2 camera navigation is unsupported.",
  "areas": [
    "maui"
  ],
  "exampleLanguages": [
    "csharp"
  ],
  "tags": [
    "quay-maps"
  ],
