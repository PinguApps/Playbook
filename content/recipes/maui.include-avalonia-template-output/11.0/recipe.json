{
  "id": "maui.include-avalonia-template-output",
  "edition": "11.0",
  "title": "Generate a MAUI project with an Avalonia desktop head",
  "goal": "Use the first-party MAUI template integration to add an Avalonia desktop target with pinned third-party prerequisites.",
  "areas": [
    "maui"
  ],
  "exampleLanguages": [
    "csharp"
  ],
  "tags": [
    "quay-integration",
    "avalonia"
  ],
  "apis": [
    "dotnet new maui --with-avalonia",
    "AvaloniaControlsMauiGenerateBootstrap"
  ],
  "introducedIn": "11.0",
  "supportedTargets": [
    "11.0"
  ],
  "stability": "preview",
  "applicability": {
    "routes": [
      {
        "requirements": {
          "runtime": {
            "version": "11.0",
            "match": "release-family",
            "reason": "Actual .NET11 package or native application target; older .NET10 example is comparison-only.",
            "name": ".NET"
          },
          "sdk": {
            "version": "11.0",
            "match": "release-family",
            "reason": "SDK11 and matching MAUI workload for native heads; neutral contract consumer is workload-free.",
            "name": ".NET SDK"
          },
          "language": {
            "version": "15.0",
            "match": "exact",
            "reason": "Canonical current samples use C#15 without preview syntax.",
            "name": "C#"
          },
          "frameworks": [
            ".NET MAUI"
          ],
          "packages": [
            {
              "match": "exact",
              "name": "Microsoft.Maui.Controls",
              "version": "11.0.0",
              "reason": "Reviewed current MAUI artifact baseline."
            },
            {
              "match": "exact",
              "name": "Avalonia.Controls.Maui",
              "version": "11.0.0",
              "reason": "Explicit third-party template integration prerequisite."
            },
            {
              "match": "exact",
              "name": "Avalonia.Controls.Maui.Desktop",
              "version": "11.0.0",
              "reason": "Explicit third-party template integration prerequisite."
            },
            {
              "match": "exact",
              "name": "Microsoft.Maui.Resizetizer",
              "version": "11.0.0",
              "reason": "Explicit neutral asset consumer prerequisite; ordinary generated UseMaui heads obtain matched asset tooling through the MAUI workload."
            },
            {
              "name": "Microsoft.Extensions.Logging.Debug",
              "version": "11.0.0",
              "match": "exact",
              "reason": "Generated logging pin compiled in the canonical neutral consumer with AddDebug."
            }
          ],
          "packageAssets": [
            "Actual net11.0 neutral MAUI assets; native heads require the corresponding platform-specific assets."
          ],
          "workloads": [],
          "providers": [
            "No external provider or account"
          ],
          "platforms": [
            "Windows authoring; net11.0 neutral contract/desktop consumer or explicitly declared Windows native target. Android/Apple native targets are not tested."
          ],
          "renderingModes": [
            "MAUI/native or Avalonia desktop; contract-only tests do not render."
          ],
          "prerequisites": [
            "See exact canonical pins and independent package locks; tool host itself requires no MAUI workload.",
            "Neutral package consumer is workload-free; ordinary generated native heads require matched MAUI workloads and platform toolchains."
          ],
          "constraints": [
            "RC2 preparation evidence, not GA verification. No verified older-target route. Native behavior exclusions and contract doubles are explicit in Evidence."
          ],
          "optIns": [
            "--with-avalonia or maui-multiproject --avalonia; AvaloniaControlsMauiGenerateBootstrap=true."
          ],
          "stabilityLimitations": [
            "Avalonia integration packages are prerelease."
          ]
        },
        "sharedAreas": [],
        "conditional": false,
        "target": "11.0",
        "neutralLanguages": [],
        "usage": "primary",
