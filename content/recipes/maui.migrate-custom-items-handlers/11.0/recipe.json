{
  "id": "maui.migrate-custom-items-handlers",
  "edition": "11.0",
  "title": "Migrate custom collection and carousel handlers by platform",
  "goal": "Apply when upgrading custom MAUI item controls: use Items2 on Apple, adopt Windows CollectionView2 or retain its supported legacy fallback.",
  "areas": [
    "maui"
  ],
  "exampleLanguages": [
    "csharp"
  ],
  "tags": [
    "jetty-handlers",
    "collectionview",
    "carouselview"
  ],
  "apis": [
    "CollectionViewHandler2",
    "CarouselViewHandler2",
    "UseWindowsCollectionView2Handler"
  ],
  "introducedIn": "11.0",
  "supportedTargets": [
    "11.0"
  ],
  "stability": "stable",
  "applicability": {
    "routes": [
      {
        "requirements": {
          "runtime": {
            "version": "11.0",
            "match": "release-family",
            "reason": "MAUI .NET 11 native application; CoreCLR is the default mobile runtime. No NativeAOT execution claim.",
            "name": ".NET"
          },
          "sdk": {
            "version": "11.0",
            "match": "release-family",
            "reason": "Compatible .NET 11 SDK and the selected native workload are required; sample pins SDK11 GA.",
            "name": ".NET SDK"
          },
          "language": {
            "version": "15.0",
            "match": "exact",
            "reason": "Canonical sample uses C#15, no preview language feature.",
            "name": "C#"
          },
          "frameworks": [
            ".NET MAUI"
          ],
          "packages": [
            {
              "match": "release-family",
              "name": "Microsoft.Maui.Controls",
              "reason": "Canonical samples pin Controls11.0.0; exact Core package downloaded and inspected.",
              "version": "11.0"
            }
          ],
          "packageAssets": [
            "Controls.Core11 GA net11.0-ios27.0 and net11.0-windows10.0.20348 assets; matching native SDK/workloads required."
          ],
          "workloads": [
            {
              "name": "maui-android / maui-ios / maui-windows (choose target)",
              "version": "11.0",
              "match": "release-family",
              "reason": "Install the workload matching the selected target. Reviewed set11.0.100 selects MAUI11.0.0, Android37.2.29 and Apple27.0.12212-net11-rc.2."
            }
          ],
          "providers": [
            "No external provider or account"
          ],
          "platforms": [
            "iOS27/minimum18.2 and Windows20348/minimum17763 in canonical projects; Apple obsoletion also applies to Mac Catalyst."
          ],
          "renderingModes": [
            "Native MAUI controls; no Blazor rendering mode"
          ],
          "prerequisites": [
            "Compatible Apple workload, Mac/Xcode and native SDK; unavailable on this Windows authoring machine."
          ],
          "constraints": [
            "Apple legacy item handlers are obsolete. Windows legacy CollectionViewHandler remains supported. Windows CarouselView does not use the Apple Items2 carousel handler."
          ],
          "optIns": [
            "UseWindowsCollectionView2Handler=false temporarily selects the legacy Windows default; custom registrations must also select their intended base class."
          ],
          "stabilityLimitations": [
            "Stable API guidance based on pinned GA artifacts, within the recorded verification scope. No NativeAOT or trimming execution claim."
          ]
        },
        "sharedAreas": [],
        "conditional": false,
        "target": "11.0",
        "neutralLanguages": [],
        "usage": "primary",
        "evidenceSamples": [
          "samples/net11.0/JettyItems/JettyItems.csproj",
          "samples/net11.0/JettyWindows/JettyWindows.csproj"
        ],
        "selectionNotes": [
          "No verified older-target route; .NET 10 is comparison-only."
        ],
