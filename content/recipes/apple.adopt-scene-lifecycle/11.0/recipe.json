          "https://raw.githubusercontent.com/dotnet/core/60871330fce2b3da383461be027ebdf3ce30f8fb/release-notes/11.0/preview/rc2/dotnetmaui.md",
          "https://github.com/dotnet/macios/releases/tag/dotnet-11.0.1xx-rc2-12212"
        ],
        "evidenceSamples": [
