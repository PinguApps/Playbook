{
  "id": "apple.adopt-scene-lifecycle",
  "edition": "11.0",
  "title": "Move Apple launch handling to window scenes",
  "goal": "Migrate existing iOS and Mac Catalyst startup and launch actions to the scene lifecycle required by Xcode 27 while preserving a single window.",
  "areas": [
    "ios",
    "maccatalyst",
    "maui"
  ],
  "exampleLanguages": [
    "csharp"
  ],
  "tags": [
    "lifecycle-guidance",
    "migration"
  ],
  "apis": [
    "MauiUISceneDelegate",
    "UIApplicationSceneManifest",
    "UISceneConnectionOptions",
    "PerformActionForShortcutItem"
  ],
  "introducedIn": "11.0",
  "supportedTargets": [
    "11.0"
  ],
  "stability": "stable",
  "applicability": {
    "routes": [
      {
        "target": "11.0",
        "conditional": false,
        "usage": "primary",
        "selectionNotes": [
          "Comparisons preserve the eight .NET10 foundations; no older route added."
        ],
        "requirements": {
          "runtime": {
            "name": ".NET",
            "version": "11.0",
            "match": "release-family",
            "reason": "Apple .NET11 workload; native runtime execution not-tested."
          },
          "sdk": {
            "name": ".NET SDK",
            "version": "11.0",
            "match": "release-family",
            "reason": "RC3 SDK selected; pinned Apple and MAUI sources are preparation evidence, not a tested RC3 workload composition."
          },
          "language": {
            "name": "C#",
            "version": "15.0",
            "match": "exact",
            "reason": "C#15; no preview syntax."
          },
          "frameworks": [
            ".NET for iOS",
            ".NET for Mac Catalyst",
            ".NET MAUI"
          ],
          "packages": [
            {
              "version": "11.0.0",
              "name": "Microsoft.Maui.Controls",
              "match": "exact",
              "reason": "MAUI variant only; base UIKit variant has no MAUI package."
            }
          ],
          "workloads": [
            {
              "match": "release-family",
              "version": "11.0",
              "name": "ios",
              "reason": "Compatible workload required; RC3 native composition not built."
            }
          ],
          "packageAssets": [
            "Microsoft.iOS.Ref.net11.0_27.0/27.0.12212-net11-rc.2 ref/net11.0/Microsoft.iOS.dll",
            "Microsoft.Maui.Core/11.0.0 lib/net11.0-ios27.0/Microsoft.Maui.dll",
            "Microsoft.Maui.Controls.Core/11.0.0 lib/net11.0-ios27.0/Microsoft.Maui.Controls.dll"
          ],
          "providers": [
            "No external service or account"
          ],
          "platforms": [
            "iOS 15+; Mac Catalyst17+; Xcode27 SDKs require scenes; sample ios-arm64"
          ],
          "renderingModes": [
            "UIKit window scene or MAUI native window; no Blazor render mode"
          ],
          "prerequisites": [
            "Xcode27.0 on macOS26.6+ for native packaging/execution.",
            "Register the scene delegate using its exact Objective-C name.",
            "MAUI scene configuration name must be __MAUI_DEFAULT_SCENE_CONFIGURATION__."
          ],
          "constraints": [
            ".NET10 samples are comparison-only; no older-target recipe route.",
            "Unavailable native compilation/execution is explicitly not-tested under PIN-699.",
            "No service/account/resource provisioning required."
          ],
          "optIns": [],
          "stabilityLimitations": [
            "RC source/artifact preparation evidence; no GA certification."
          ]
        },
        "sourceUrls": [
          "https://raw.githubusercontent.com/dotnet/maui/7deff1e006978d1eed341ffcac899a85510f76bb/src/Core/src/Platform/iOS/MauiUISceneDelegate.cs",
          "https://raw.githubusercontent.com/dotnet/maui/7deff1e006978d1eed341ffcac899a85510f76bb/src/Templates/src/templates/maui-mobile/Platforms/iOS/Info.plist",
