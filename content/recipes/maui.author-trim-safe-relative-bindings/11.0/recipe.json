{
  "id": "maui.author-trim-safe-relative-bindings",
  "edition": "11.0",
  "title": "Keep ancestor and named-control bindings safe for trimming",
  "goal": "Use resolvable ancestor and named-control types when a MAUI screen must retain its bound members under trimming.",
  "areas": [
    "maui"
  ],
  "exampleLanguages": [
    "csharp"
  ],
  "tags": [
    "signaldeck",
    "bindings"
  ],
  "apis": [
    "RelativeSource",
    "x:Reference",
    "TypedBinding"
  ],
  "introducedIn": "11.0",
  "supportedTargets": [
    "11.0"
  ],
  "stability": "stable",
  "applicability": {
    "routes": [
      {
        "requirements": {
          "runtime": {
            "version": "11.0",
            "match": "release-family",
            "reason": "MAUI .NET 11 native application; CoreCLR is the default mobile runtime. No NativeAOT execution claim.",
            "name": ".NET"
          },
          "sdk": {
            "version": "11.0",
            "match": "release-family",
            "reason": "Compatible .NET 11 SDK and the selected native workload are required; sample pins SDK11 RC3.",
            "name": ".NET SDK"
          },
          "language": {
            "version": "15.0",
            "match": "exact",
            "reason": "Canonical sample pins C#15; no preview C# expressions.",
            "name": "C#"
          },
          "frameworks": [
            ".NET MAUI"
          ],
          "packages": [
            {
              "match": "release-family",
              "name": "Microsoft.Maui.Controls",
              "reason": "Controls11 SourceGen compiler and preview incremental reload engine; sample pins 11.0.0.",
              "version": "11.0"
            }
          ],
          "packageAssets": [
            "Controls11 Windows20348, Android37.2 and iOS27.0 target assets plus Build.Tasks SourceGen analyzer/targets. Intended native dependency closure is unresolved on this host."
          ],
          "workloads": [
            {
              "name": "maui-android / maui-ios / maui-windows (choose target)",
              "version": "11.0",
              "match": "release-family",
              "reason": "Install the workload matching the selected target. Reviewed set11.0.100 selects MAUI11.0.0, Android37.2.0-rc.2.84 and Apple27.0.12212-net11-rc.2."
            }
          ],
          "providers": [
            "No external provider or account"
          ],
          "platforms": [
            "Windows x64 (binding20348, minimum17763); Android (binding37.2, minimum24); iOS (binding27.0, minimum18.2). iOS CLI requires a Mac, compatible Xcode and selected simulator/device."
          ],
          "renderingModes": [
            "Native MAUI controls; no Blazor rendering mode"
          ],
          "prerequisites": [
            "Matching native SDK pack, platform tooling and a configured device/emulator for live checks; workload labels alone do not establish availability.",
            "Android preparation uses JDK25 and Android SDK/build tools matching the reviewed workload; Apple preparation uses the reviewed Xcode27.0 RC2 composition."
          ],
          "constraints": [
            "No provider/account for Playbook retrieval. Device signing/trust is separate and not provisioned by this guidance.",
            "Windows cannot launch an iOS app through this CLI route.",
            "Compilation, trimming and live reload are distinct claims; see Evidence."
          ],
          "optIns": [
            "MauiXamlInflator=SourceGen; no EnablePreviewFeatures needed for these bindings."
          ],
          "stabilityLimitations": [
            "RC2 preparation only, no GA verification. Native current sample is official-source reviewed only."
          ]
        },
        "sharedAreas": [],
        "conditional": false,
        "target": "11.0",
        "neutralLanguages": [],
        "usage": "primary",
        "evidenceSamples": [
          "samples/net11.0/SignalDeck/SignalDeck.csproj",
          "samples/net11.0/SignalDeckAndroid/SignalDeckAndroid.csproj",
          "samples/net11.0/SignalDeckiOS/SignalDeckiOS.csproj"
        ],
        "selectionNotes": [
          "No verified older-target route; .NET 10 is comparison-only."
        ],
        "sourceUrls": [
