{
  "id": "maui.choose-xaml-generation",
  "edition": "11.0",
  "title": "Migrate a MAUI page to SourceGen",
  "goal": "Move an existing MAUI page to SourceGen, simplify standard namespace declarations and preserve custom type mappings without claiming automatic performance gains.",
  "areas": [
    "maui"
  ],
  "exampleLanguages": [
    "csharp"
  ],
  "tags": [
    "quay-board",
    "sourcegen",
    "xaml"
  ],
  "apis": [
    "MauiXamlInflator"
  ],
  "introducedIn": "11.0",
  "supportedTargets": [
    "11.0"
  ],
  "stability": "stable",
  "applicability": {
    "routes": [
      {
        "requirements": {
          "runtime": {
            "version": "11.0",
            "match": "release-family",
            "reason": "Windows MAUI target net11.0-windows10.0.20348.0; native execution is not tested.",
            "name": ".NET"
          },
          "sdk": {
            "version": "11.0",
            "match": "release-family",
            "reason": "MAUI .NET 11 SourceGen authoring requires a compatible .NET 11 SDK and installed platform workload; measured preparation versions are recorded separately.",
            "name": ".NET SDK"
          },
          "language": {
            "version": "15.0",
            "match": "exact",
            "reason": "Explicit C#15 sample mode; XAML preview opt-in is separate from C# language mode.",
            "name": "C#"
          },
          "frameworks": [
            "MAUI Windows"
          ],
          "packages": [
            {
              "match": "release-family",
              "name": "Microsoft.Maui.Controls",
              "reason": "The .NET 11 Controls release supplies the SourceGen authoring model described here; use matching platform assets.",
              "version": "11.0"
            }
          ],
          "packageAssets": [
            "Microsoft.Maui.Controls net11.0-windows10.0.20348 assets and buildTransitive SourceGen analyzer/targets; older comparison pins Controls10.0.110."
          ],
          "workloads": [
            {
              "match": "release-family",
              "name": "maui-windows",
              "reason": "Building the Windows page requires the MAUI Windows SDK pack for the .NET 11 release family.",
              "version": "11.0"
            }
          ],
          "providers": [
            "No external provider or account"
          ],
          "platforms": [
            "Windows x64; target binding20348, minimum OS17763; local host26200."
          ],
          "renderingModes": [
            "Native MAUI controls; no Blazor rendering mode"
          ],
          "prerequisites": [
            "Use a matching installed MAUI SDK pack; workload-list labels alone do not establish availability."
          ],
          "constraints": [
            "Current native sample is source-reviewed only under PIN-699. Standard generator migration does not require preview C# expressions."
          ],
          "optIns": [
            "MauiXamlInflator=SourceGen; the separate companion page also enables preview expressions."
          ],
          "stabilityLimitations": [
            "RC2 preparation evidence; no GA verification. x:Code/C# expressions are preview, including in the companion migration sample.",
            "Reviewed Controls and Build.Tasks 11.0.0-rc.2.26505.5 artifacts; intended SDK 11.0.100-rc.2.26504.105. The current native dependency closure was not resolved because the SDK pack is unavailable; these are preparation baselines, not required downgrades."
          ]
        },
