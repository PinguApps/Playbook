{
  "id": "blazor.capture-loop-items-safely",
  "edition": "11.0",
  "title": "Bind each repeated action to its own item",
  "goal": "Prevent repeated component actions from sharing a changing for-loop iterator by capturing a per-iteration value, with safe foreach behavior as a control.",
