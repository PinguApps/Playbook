{
  "id": "blazor.preserve-wasm-navigation-state",
  "edition": "11.0",
  "title": "Preserve WebAssembly navigation state",
  "goal": "Preserve deliberate browser history state and observe committed locations when migrating application navigation away from framework-only notifications.",
  "areas": [
    "blazor"
  ],
  "exampleLanguages": [
    "csharp"
  ],
  "tags": [
    "migration",
    "navigation-state"
  ],
  "apis": [
    "NavigationManager.NavigateTo",
    "NavigationOptions.HistoryEntryState",
    "NavigationManager.LocationChanged",
    "JSInteropMethods.NotifyLocationChanged"
  ],
  "introducedIn": "11.0",
  "supportedTargets": [
    "11.0"
  ],
  "stability": "stable",
  "applicability": {
    "routes": [
      {
        "target": "11.0",
        "conditional": false,
        "usage": "primary",
        "selectionNotes": [
          "Client-side WebAssembly navigation with matching framework JS/managed assets; framework notifications are not supported application APIs.",
          "History state belongs to an individual entry. A fresh intercepted link has no deliberate state; Back/Forward restores the target entry state."
        ],
        "requirements": {
          "runtime": {
            "name": ".NET",
            "version": "11.0",
            "match": "release-family",
            "reason": "Run matching .NET 11 browser WebAssembly assets."
          },
          "sdk": {
            "name": ".NET SDK",
            "version": "11.0",
            "match": "release-family",
            "reason": "Build the net11.0 WebAssembly application with its matching SDK assets."
          },
          "language": {
            "name": "C#",
            "version": "15.0",
            "match": "exact",
            "reason": "Declared current sample compiler mode, not the introduction of these APIs."
          },
          "frameworks": [
            "ASP.NET Core Blazor"
          ],
          "packages": [
            {
              "version": "11.0",
              "name": "Microsoft.AspNetCore.Components.WebAssembly",
              "reason": "Matching browser component managed and JS assets.",
              "match": "release-family"
            },
            {
              "version": "11.0",
              "name": "Microsoft.AspNetCore.Components.WebAssembly.DevServer",
              "reason": "Local sample development server, not a production requirement.",
              "match": "release-family"
            }
          ],
          "packageAssets": [
            "Matching net11.0 managed compile/runtime assets, blazor.webassembly.js and browser-wasm runtime; sample pins 11.0.0-rc.2.26504.105"
          ],
          "workloads": [],
          "providers": [],
          "platforms": [
            "Browser with WebAssembly; local development server on Windows x64 verified"
          ],
          "renderingModes": [
            "Standalone client-side WebAssembly"
          ],
          "prerequisites": [
            "Use Microsoft.NET.Sdk.BlazorWebAssembly and retain matching JS/managed/runtime assets. Default interpreted WASM builds need no optional workload, native SDK or provider; AOT and production publish are not demonstrated."
          ],
          "constraints": [
            "Use NavigationManager for application navigation, and LocationChanged for committed URI/state observations. Neither NotifyLocationChanged overload navigates the browser or is supported for application use.",
            "No relative-routing, CSP, remote authentication, server SSR, Hybrid, worker, deployment or older-target/new-package route is established."
          ],
          "optIns": [],
          "stabilityLimitations": [
            "Supported application APIs are stable; actual current evidence is RC2 and GA reconciliation remains pending."
          ]
        },
        "sourceUrls": [
          "https://github.com/dotnet/aspnetcore/blob/0ef4bbfa3291b306a21e5001cb0491277bdd35bc/src/Components/WebAssembly/WebAssembly/src/Infrastructure/JSInteropMethods.cs",
          "https://github.com/dotnet/aspnetcore/blob/4a70870818bf5662f21b0c28f9a8c267dccb77f0/src/Components/WebAssembly/WebAssembly/src/Infrastructure/JSInteropMethods.cs",
          "https://github.com/dotnet/aspnetcore/blob/4a70870818bf5662f21b0c28f9a8c267dccb77f0/src/Components/Components/src/NavigationOptions.cs",
          "https://github.com/dotnet/aspnetcore/blob/4a70870818bf5662f21b0c28f9a8c267dccb77f0/src/Components/WebAssembly/WebAssembly/src/Services/WebAssemblyNavigationManager.cs"
        ],
        "evidenceSamples": [
          "samples/net11.0/MineralArchive/MineralArchive.csproj"
        ]
      }
    ]
  },
