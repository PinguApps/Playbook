<!-- snippet:queue -->
@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject QueueJournal Journal

<h1>Lantern collection queue</h1>
<p>Jump to a collection ticket. Indices are zero based, from 0 to 199.</p>
<label>Ticket index <input id="target" type="number" @bind="_target" /></label>
<button id="reveal" disabled="@(!_ready || _busy)" @onclick="RevealAsync">Reveal ticket</button>
<output id="status" aria-live="polite">@_status</output>
<div id="queue" tabindex="0" aria-label="Collection tickets">
    <Virtualize TItem="LanternTicket" @ref="_list" ItemsProvider="LoadAsync"
                ItemComparer="EqualityComparer<LanternTicket>.Default"
                ItemSize="40" OverscanCount="3" InitialItemIndex="Initial">
        <ItemContent Context="ticket"><div class="ticket" data-index="@ticket.Index">@ticket.Label</div></ItemContent>
        <Placeholder><div class="ticket">Loading ticket…</div></Placeholder>
    </Virtualize>
</div>

@code {
    [SupplyParameterFromQuery] public int Initial { get; set; } = 70;
    [SupplyParameterFromQuery] public string Run { get; set; } = "manual";
    private Virtualize<LanternTicket> _list = default!;
    private int _target = 150;
    private bool _ready;
    private bool _rendered;
    private bool _dataReady;
    private bool _busy;
    private string _status = "Starting";

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { _rendered = true; EnableReveal(); }
    }

    private void EnableReveal()
    {
        if (_rendered && _dataReady && !_ready)
        {
            _ready = true;
            _status = "Ready";
            StateHasChanged();
        }
    }

    private async ValueTask<ItemsProviderResult<LanternTicket>> LoadAsync(ItemsProviderRequest request)
    {
        ItemsProviderResult<LanternTicket> result = await Journal.LoadAsync(Run, request);
        if (!_dataReady) { _dataReady = true; await InvokeAsync(EnableReveal); }
        return result;
    }

    private async Task RevealAsync()
    {
        // An application can reject invalid input even though Virtualize clamps indices.
        if (_target < 0 || _target >= QueueJournal.Total) { _status = "Choose an index from 0 to 199"; return; }
        _busy = true;
        _status = $"Revealing {_target}";
        try
        {
            await _list.ScrollToItemAsync(_target);
            _status = $"Revealed {_target}";
        }
        finally { _busy = false; }
    }
}
<!-- endsnippet:queue -->
