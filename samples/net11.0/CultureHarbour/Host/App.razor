@namespace CultureHarbour.Host
@using System.Globalization
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head><meta charset="utf-8" /><base href="/" /><title>Culture Harbour</title>
<style>body { font: 1.2rem system-ui; max-width: 50rem; margin: 3rem auto; padding: 1rem; } dt { font-weight: bold; } dd { margin-bottom: 1rem; }</style>
</head>
<body data-independent="@(Configuration.GetValue<bool>("IndependentClient").ToString().ToLowerInvariant())"
      data-edition="11" data-server-culture="@CultureInfo.CurrentCulture.Name"
      data-server-ui="@CultureInfo.CurrentUICulture.Name">
    <Routes />
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="culture.js"></script>
</body>
</html>
<!-- endsnippet:complete -->
