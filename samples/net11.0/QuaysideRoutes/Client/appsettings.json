{
  "Gateway": {
    "HttpsRedirection": {
      "Enabled": false
    },
    "Telemetry": {
      "Enabled": false
    }
  },
  "services": {
    "quaybackend": {
      "http": [
        "http://127.0.0.1:5914"
      ]
    }
  },
  "ReverseProxy": {
    "Routes": {
      "quays": {
        "ClusterId": "quays",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "quays": {
        "Destinations": {
          "local": {
            "Address": "http://quaybackend/"
          }
        }
      }
    }
  },
  "ClientApps": {
    "app": {
      "ConfigEndpointPath": "/_blazor/_configuration",
      "ConfigResponse": "{\"webAssembly\":{\"environment\":{\"services__quays__http__0\":\"http://localhost:5912\"}}}"
    }
  }
}
