<!-- snippet:project -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework><LangVersion>15.0</LangVersion>
    <PublishAot>true</PublishAot><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IlcUseEnvironmentalTools>true</IlcUseEnvironmentalTools>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EstuaryHook Condition="'$(EstuaryHook)' == ''">publish</EstuaryHook>
    <EstuaryCargo Condition="'$(EstuaryCargo)' == ''">copper-lanterns</EstuaryCargo>
  </PropertyGroup>
  <ItemGroup><Compile Include="../../net10.0/EstuaryNative/Program.cs" Link="Program.cs" /></ItemGroup>
  <ItemGroup><AdditionalNativeLibraryDirectories Include="$(EstuaryMsvcLibraries);$(EstuaryUmLibraries);$(EstuaryUcrtLibraries)" /></ItemGroup>
  <Target Name="GenerateEstuaryLegacyManifest" AfterTargets="Build" Condition="'$(EstuaryHook)' == 'legacy'">
    <WriteLinesToFile File="$(IntermediateOutputPath)berth.txt" Lines="$(EstuaryCargo)" Overwrite="true" />
    <Message Text="ESTUARY_HOOK:legacy:$(EstuaryCargo)" Importance="high" />
  </Target>
  <Target Name="GenerateEstuaryPublishManifest" BeforeTargets="ComputeFilesToPublish" Condition="'$(EstuaryHook)' == 'publish'">
    <WriteLinesToFile File="$(IntermediateOutputPath)berth.txt" Lines="$(EstuaryCargo)" Overwrite="true" />
    <Message Text="ESTUARY_HOOK:publish:$(EstuaryCargo)" Importance="high" />
  </Target>
  <Target Name="IncludeEstuaryManifest" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="GenerateEstuaryPublishManifest">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(IntermediateOutputPath)berth.txt" Condition="Exists('$(IntermediateOutputPath)berth.txt')">
        <RelativePath>berth.txt</RelativePath><CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
<!-- endsnippet:project -->
