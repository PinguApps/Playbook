@page "/progress"
@inject NavigationManager Navigation

<!-- snippet:progress -->
<h2>Continue the permit</h2>
<p id="progress">Step @Step; berth @(Berth ?? "unselected")</p>
<EditForm Model="Input" FormName="progress" OnSubmit="Continue">
    <label>Berth <InputText @bind-Value="Input!.Berth" /></label>
    <button type="submit">Continue</button>
</EditForm>

@code {
    [SupplyParameterFromSession(Name = "permit-berth")]
    public string? Berth { get; set; }

    [SupplyParameterFromSession(Name = "permit-step")]
    public int Step { get; set; }

    [SupplyParameterFromForm]
    private PermitInput? Input { get; set; }

    protected override void OnInitialized() => Input ??= new() { Berth = Berth };

    private void Continue()
    {
        Berth = Input!.Berth;
        Step++;
        Navigation.NavigateTo("/review");
    }
}
<!-- endsnippet:progress -->
