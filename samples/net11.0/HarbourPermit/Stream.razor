@page "/stream"
@attribute [StreamRendering]
@inject InspectionGate Gate

<!-- snippet:stream -->
<p id="inspection">@(_complete ? "Inspection saved" : "Inspection pending")</p>
<p id="headers">Headers started: @_headersStarted</p>

@code {
    // Create the subscription before the first asynchronous flush, even with no incoming cookie.
    [SupplyParameterFromSession(Name = "permit-step")]
    public int Step { get; set; }

    [CascadingParameter]
    public ITempData TempData { get; set; } = default!;

    [CascadingParameter]
    public HttpContext Context { get; set; } = default!;

    private bool _complete;
    private bool _headersStarted;

    protected override async Task OnInitializedAsync()
    {
        await Gate.WaitAsync(Context.RequestAborted);
        _headersStarted = Context.Response.HasStarted;
        Step = 7;
        TempData["permit-outcome"] = "Dock inspection complete";
        _complete = true;
    }
}
<!-- endsnippet:stream -->
