<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
<!-- endsnippet:boundary -->
