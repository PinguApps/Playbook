<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <FrameworkPathOverride>/usr/lib/mono/4.7.2-api</FrameworkPathOverride>
    <OutputPath>bin/importer output/</OutputPath>
    <StartArguments>&quot;night survey&quot; 7</StartArguments>
  </PropertyGroup>
  <!-- snippet:launch -->
  <PropertyGroup Condition="'$(ExplicitMono)' == 'true'">
    <RunCommand>/usr/bin/mono</RunCommand>
  </PropertyGroup>
  <Target Name="ConfigureExplicitMono" BeforeTargets="ComputeRunArguments" Condition="'$(ExplicitMono)' == 'true'">
    <PropertyGroup>
    <RunCommand>/usr/bin/mono</RunCommand>
    <RunArguments>&quot;$(TargetPath)&quot; $(StartArguments)</RunArguments>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)/working directory</RunWorkingDirectory>
    </PropertyGroup>
  </Target>
  <!-- endsnippet:launch -->
</Project>
