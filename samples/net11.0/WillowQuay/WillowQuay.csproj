<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <DefineConstants Condition="'$(OmitTimerRender)' == 'true'">$(DefineConstants);OMIT_TIMER_RENDER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Before/**/*.razor" Condition="'$(BeforeMigration)' != 'true'" />
    <Content Remove="TicketDisplay.razor;FeedingControls.razor;InstrumentPanel.razor" Condition="'$(BeforeMigration)' == 'true'" />
  </ItemGroup>
</Project>
<!-- endsnippet:complete -->
