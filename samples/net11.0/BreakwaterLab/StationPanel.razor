@namespace BreakwaterLab
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inherits StationPanelBase
@implements IAsyncDisposable

<p id="station">@Station.Value</p>
<p id="activation">custom property policy</p>
<p id="session">@Session.Value</p>
<p id="scale">Multiplier: @Scale.Multiplier</p>
<p id="ready">@(_module is null ? "Starting" : "Interactive")</p>
<button id="increase" disabled="@(_module is null)" @onclick="IncreaseAsync">Add one reading</button>
<button id="invalid" disabled="@(_module is null)" @onclick="RejectAsync">Try invalid announcement</button>
<p id="outcome">@_outcome</p>
<output id="announcement"></output>
@if (_visible)
{
    <math id="formula">
        <mrow><mi>d</mi><mo>=</mo><mn id="reading">@_reading</mn><mo>×</mo><mn>@Scale.Multiplier</mn></mrow>
    </math>
}
@code {
    private IJSObjectReference? _module;
    private int _reading = 2;
    private string _outcome = "No announcement";
    private bool _visible;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./station.js");
                _visible = true;
            }
            catch (JSException)
            {
                _outcome = "Browser setup failed";
            }
            StateHasChanged();
        }
    }

    private async Task IncreaseAsync()
    {
        _reading++;
        try
        {
            await _module!.InvokeVoidAsync("announce", Station.Value, _reading);
            _outcome = $"Announced reading {_reading}";
        }
        catch (JSException)
        {
            _outcome = "Announcement failed";
        }
    }

    private async Task RejectAsync()
    {
        try
        {
            await _module!.InvokeVoidAsync("announce", "", _reading);
        }
        catch (JSException)
        {
            _outcome = "Announcement rejected";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // A disconnected server circuit cannot release a browser reference.
            }
        }
    }
}
<!-- endsnippet:complete -->
