<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.coastal.probe</ApplicationId>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <TargetSdkVersion>36</TargetSdkVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <RunAOTCompilation>false</RunAOTCompilation>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;Bindings/**</DefaultItemExcludes>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AndroidPackageNamingPolicy>LowercaseCrc64</AndroidPackageNamingPolicy>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ProbePeer.cs" />
    <ProjectReference Include="Bindings/ProbeBindings.csproj" />
  </ItemGroup>
</Project>
<!-- endsnippet:complete -->
