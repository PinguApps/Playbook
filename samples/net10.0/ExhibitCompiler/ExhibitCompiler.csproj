<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><LangVersion>14.0</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><OutputType>Exe</OutputType><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><RootNamespace>ExhibitCompiler</RootNamespace>
    <ExhibitTooling>$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk.Razor</ExhibitTooling>
    <ExhibitHost>$(NetCoreRoot)dotnet</ExhibitHost>
    <ExhibitHost Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(NetCoreRoot)dotnet.exe</ExhibitHost>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="ExhibitParts/ExhibitParts.csproj" />
    <Compile Remove="ExhibitParts/**/*.cs" />
  </ItemGroup>
  <UsingTask TaskName="Microsoft.AspNetCore.Razor.Tasks.SdkRazorTagHelper" AssemblyFile="$(ExhibitTooling)/tasks/net10.0/Microsoft.NET.Sdk.Razor.Tasks.dll" />
  <UsingTask TaskName="Microsoft.AspNetCore.Razor.Tasks.SdkRazorGenerate" AssemblyFile="$(ExhibitTooling)/tasks/net10.0/Microsoft.NET.Sdk.Razor.Tasks.dll" />
  <Target Name="CompileExhibit" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <PropertyGroup>
      <ExhibitGenerated>$(IntermediateOutputPath)Exhibit.g.cs</ExhibitGenerated>
      <ExhibitManifest>$(IntermediateOutputPath)exhibit.taghelpers.json</ExhibitManifest>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ItemGroup>
      <ExhibitSource Include="Exhibit.razor">
        <TargetPath>Exhibit.razor</TargetPath><GeneratedOutput>$(ExhibitGenerated)</GeneratedOutput><DocumentKind>component</DocumentKind>
      </ExhibitSource>
      <ExhibitConfiguration Include="MVC-3.0" />
      <ExhibitReference Include="@(ReferencePath)" />
    </ItemGroup>
    <SdkRazorTagHelper ToolAssembly="$(ExhibitTooling)/tools/rzc.dll"
      ToolExe="$([System.IO.Path]::GetFileName('$(ExhibitHost)'))" ToolPath="$([System.IO.Path]::GetDirectoryName('$(ExhibitHost)'))"
      UseServer="false" Version="10.0" Configuration="@(ExhibitConfiguration)" Extensions=""
      Assemblies="@(ExhibitReference)" ProjectRoot="$(MSBuildProjectDirectory)"
      TagHelperManifest="$(ExhibitManifest)" />
    <SdkRazorGenerate ToolAssembly="$(ExhibitTooling)/tools/rzc.dll"
      ToolExe="$([System.IO.Path]::GetFileName('$(ExhibitHost)'))" ToolPath="$([System.IO.Path]::GetDirectoryName('$(ExhibitHost)'))"
      UseServer="false" Version="10.0" CSharpLanguageVersion="$(LangVersion)" RootNamespace="$(RootNamespace)"
      Configuration="@(ExhibitConfiguration)" Extensions="" Sources="@(ExhibitSource)"
      ProjectRoot="$(MSBuildProjectDirectory)" TagHelperManifest="$(ExhibitManifest)" />
    <CreateItem Include="$(ExhibitGenerated)"><Output TaskParameter="Include" ItemName="Compile" /></CreateItem>
  </Target>
</Project>
<!-- endsnippet:complete -->
