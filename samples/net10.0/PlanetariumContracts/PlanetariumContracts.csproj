    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />

  <Compile Include="../../net11.0/PlanetariumContracts/ContractChecks.cs" Link="ContractChecks.cs" /></ItemGroup>
</Project>
