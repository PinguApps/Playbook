@namespace BreakwaterLab
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject StationServices Services
@inject IJSRuntime JS
@implements IAsyncDisposable

<p id="station">@Services.Station.Value</p>
<p id="activation">constructor adapter</p>
<p id="session">@Services.Session.Value</p>
<p id="scale">Multiplier: @Services.Scale.Multiplier</p>
<p id="ready">@(_module is null ? "Starting" : "Interactive")</p>
<button id="increase" disabled="@(_module is null)" @onclick="IncreaseAsync">Add one reading</button>
<button id="invalid" disabled="@(_module is null)" @onclick="RejectAsync">Try invalid announcement</button>
<p id="outcome">@_outcome</p>
<output id="announcement"></output>
<div id="formula" @ref="_formula"></div>
@if (_module is not null)
{
    <math id="direct-control"><mn>@_reading</mn></math>
}
@code {
    private IJSObjectReference? _module;
    private int _reading = 2;
    private string _outcome = "No announcement";
    private ElementReference _formula;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./station.js");
                await _module.InvokeVoidAsync("drawFormula", _formula, _reading, Services.Scale.Multiplier);
            }
            catch (JSException)
            {
                _outcome = "Browser setup failed";
            }
            StateHasChanged();
        }
    }

    private async Task IncreaseAsync()
    {
        _reading++;
        try
        {
            await _module!.InvokeVoidAsync("drawFormula", _formula, _reading, Services.Scale.Multiplier);
            await _module!.InvokeAsync<object>("announce", "West breakwater", _reading);
            _outcome = $"Announced reading {_reading}";
        }
        catch (JSException)
        {
            _outcome = "Announcement failed";
        }
    }

    private async Task RejectAsync()
    {
        try
        {
            await _module!.InvokeVoidAsync("announce", "", _reading);
        }
        catch (JSException)
        {
            _outcome = "Announcement rejected";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // A disconnected server circuit cannot release a browser reference.
            }
        }
    }
}
<!-- endsnippet:complete -->
