<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableTypeScriptNuGetTarget>true</EnableTypeScriptNuGetTarget>
  </PropertyGroup>
  <ItemGroup>
    <ConfigFiles Include="tsconfig.json" />
    <Content Remove="global.json;tsconfig.json;verification*.json;*.evidence.json;packages.lock.json" />
    <ProjectReference Include="../RclAssets/RclAssets.csproj" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.9.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="RegisterPierScripts" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="CheckFileSystemCaseSensitive;FindConfigFiles;CompileTypeScriptWithTSConfig;GetTypeScriptOutputForPublishing">
    <ItemGroup>
    <ConfigFiles Include="tsconfig.json" />
    <Content Remove="global.json;tsconfig.json;verification*.json;*.evidence.json;packages.lock.json" />
      <Content Update="wwwroot/bin/berths.js" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
<!-- endsnippet:project -->
