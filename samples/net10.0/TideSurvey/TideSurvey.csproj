<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <IncludeHttpRuleProtos>true</IncludeHttpRuleProtos>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="[2.64.0]" />
    <PackageReference Include="Grpc.Net.Client" Version="[2.64.0]" />
    <PackageReference Include="Grpc.Tools" Version="[2.64.0]" PrivateAssets="All" />
    <PackageReference Include="Microsoft.AspNetCore.Grpc.JsonTranscoding" Version="[10.0.13]" />
    <PackageReference Include="Microsoft.AspNetCore.Grpc.Swagger" Version="[0.10.11]" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="[6.6.2]" />
    <Protobuf Include="tides.proto" GrpcServices="Both" />

  </ItemGroup>
</Project>
<!-- endsnippet:complete -->
