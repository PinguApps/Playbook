@page "/ledger"
@inject LedgerState Ledger
<!-- snippet:page -->
<h1>Quarry survey ledger</h1>
<p id="request">Request @Guid.NewGuid().ToString("N") for @Viewer</p>
<SurveySection Shelf="@Shelf" Revision="Revision" Viewer="@Viewer" Permission="@Permission" />
@code {
    [CascadingParameter] private HttpContext Context { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "shelf")] public string? RequestedShelf { get; set; }
    private string Shelf => RequestedShelf == "south" ? "south" : "north";
    private string Viewer => Context.User.Identity?.Name ?? "anonymous";
    private string Permission => Context.User.FindFirst("ledger-permission")?.Value ?? "none";
    private int Revision;
    protected override void OnInitialized() => Revision = Ledger.Revision;
}
<!-- endsnippet:page -->
